# Giai đoạn build, chỉ hỗ trợ kiến trúc amd64/x64
# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 node:20-bullseye AS frontend

WORKDIR /src/manager/frontend
COPY manager/frontend/package*.json ./
RUN npm ci
COPY manager/frontend ./
RUN npm run build

FROM --platform=linux/amd64 golang:1.24.4 AS builder

# Thiết lập biến môi trường cài đặt non-interactive
ENV DEBIAN_FRONTEND=noninteractive

# Cài dependency phục vụ build
RUN apt-get update && apt-get install -y \
    libopus-dev \
    libopusfile-dev \
    pkg-config \
    libc++-dev \
    libc++abi-dev \
    g++

# Sao chép file thư viện onnxruntime, chỉ dành cho x64
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# Cài ONNX Runtime cho kiến trúc x64
RUN echo "Đang cài ONNX Runtime cho kiến trúc x64" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Lỗi: không tìm thấy file ONNX Runtime!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "Không tìm thấy file .tgz" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Giải nén ONNX Runtime thất bại" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Lỗi: không tìm thấy thư mục ONNX Runtime sau khi giải nén" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Đã tìm thấy thư mục ONNX Runtime: ${ONNX_DIR}" && \
    mkdir -p /usr/local/include/onnxruntime && \
    if [ ! -d "${ONNX_DIR}include" ]; then \
        echo "Lỗi: không tìm thấy thư mục ${ONNX_DIR}include" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}include/* /usr/local/include/onnxruntime/ && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Lỗi: không tìm thấy thư mục ${ONNX_DIR}lib" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    (ldconfig 2>&1 || echo "Cảnh báo: ldconfig thất bại, vẫn tiếp tục...")

# Thiết lập biến môi trường Go
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=1

# Tạo thư mục làm việc và sao chép source code
WORKDIR /app
# Sao chép thư mục lib trước, gồm header và library ten-vad cần cho CGO build
COPY lib ./lib
COPY . .

# Kiểm tra nội dung submodule asr_server đã có trong build context, CI cần checkout với submodules: recursive
RUN test -f asr_server/server/setup.go || (echo "ERROR: thiếu nội dung submodule asr_server, build context không có package voice_server/server. CI cần checkout với submodules: recursive." && exit 1)

# Tải Go module
RUN go mod tidy

# Thiết lập đường dẫn link library CGO cho ten-vad
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime -L/app/lib/ten-vad/lib/Linux/x64"
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime -I/app/lib/ten-vad/include"

# Biên dịch chương trình chính đầy đủ AIO cho Docker package
RUN mkdir -p manager/backend/static/dist
COPY --from=frontend /src/manager/frontend/dist /app/manager/backend/static/dist
RUN go build -tags "nolibopusfile asr_server manager embed_ui tts_server" -o /app/xiaozhi_server ./cmd/server/

# Giai đoạn runtime, chỉ hỗ trợ kiến trúc amd64/x64
FROM --platform=linux/amd64 ubuntu:22.04
LABEL org.opencontainers.image.source="https://github.com/namlevia/Xiaozhi-Esp32-Server-Go-Vi"

# Thiết lập biến môi trường cài đặt non-interactive
ENV DEBIAN_FRONTEND=noninteractive

# Cài runtime dependency ở mức tối thiểu
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopus0 \
    libopusfile0 \
    libc++1 \
    libc++abi1 \
    espeak-ng-data \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Sao chép file thư viện onnxruntime, chỉ dành cho x64
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# Cài ONNX Runtime runtime cho kiến trúc x64
RUN echo "Đang cài ONNX Runtime cho kiến trúc x64" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Lỗi: không tìm thấy file ONNX Runtime!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "Không tìm thấy file .tgz" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Giải nén ONNX Runtime thất bại" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Lỗi: không tìm thấy thư mục ONNX Runtime sau khi giải nén" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Đã tìm thấy thư mục ONNX Runtime: ${ONNX_DIR}" && \
    mkdir -p /usr/local/include/onnxruntime && \
    if [ ! -d "${ONNX_DIR}include" ]; then \
        echo "Lỗi: không tìm thấy thư mục ${ONNX_DIR}include" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}include/* /usr/local/include/onnxruntime/ && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Lỗi: không tìm thấy thư mục ${ONNX_DIR}lib" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    (ldconfig 2>&1 || echo "Cảnh báo: ldconfig thất bại, vẫn tiếp tục...")

# Thiết lập biến môi trường ONNX Runtime
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"

# Thiết lập thư mục làm việc
WORKDIR /workspace

# Sao chép binary đã build từ giai đoạn build
COPY --from=builder /app/xiaozhi_server /workspace/xiaozhi_server
COPY --from=builder /app/xiaozhi_server /workspace/bin/xiaozhi_server
# Sao chép thư mục lib, gồm runtime library ten-vad và sherpa-onnx
COPY --from=builder /app/lib /workspace/lib
COPY --from=builder /app/asr_server/lib /workspace/asr_server/lib
COPY --from=builder /app/build/common/main_config.yaml /workspace/main_config.yaml
COPY --from=builder /app/build/common/manager.json /workspace/manager.json
COPY --from=builder /app/build/common/asr_server.json /workspace/asr_server.json
COPY --from=builder /app/build/common/tts_server_aio.json /workspace/tts_server.json
COPY --from=builder /app/build/common/models /workspace/models
COPY --from=builder /app/build/common/data /workspace/data
COPY --from=builder /app/tts_server/tts-model /workspace/tts-model

# Tạo các thư mục cần thiết
RUN mkdir -p /workspace/logs /workspace/config /workspace/data/piper-cache \
    && find /usr/lib /usr/share -type f -name phontab -path '*espeak-ng-data*' -print -quit | xargs -r dirname | xargs -r -I{} cp -r {} /workspace/espeak-ng-data \
    && chmod +x /workspace/xiaozhi_server /workspace/bin/xiaozhi_server

# Thiết lập đường dẫn runtime library cho ten-vad và sherpa-onnx
ENV LD_LIBRARY_PATH=/workspace/lib:/workspace/lib/ten-vad/lib/Linux/x64:/workspace/asr_server/lib

# Expose cổng: http/websocket 8989, manager 8080, ASR 9000, TTS 9001, udp 8990, mqtt 1883/2883/8883
EXPOSE 8989 8080 9000 9001 8990 1883 2883 8883

# Lệnh khởi động
CMD ["./xiaozhi_server", "-c", "main_config.yaml", "-asr-enable", "--asr-config", "asr_server.json", "--manager-enable", "--manager-config", "manager.json", "-tts-enable", "-tts-config", "tts_server.json"]
